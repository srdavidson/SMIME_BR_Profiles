    },
    "sha512WithRSAEncryption": {
      "value": "300d06092a864886f70d01010d0500",
      "description": "RSASSA-PKCS1-v1_5 with SHA-512 (SBR 7.1.3.2.1)"
    },
    "rsassaPssSha256": {
      "value": "304106092a864886f70d01010a3034a00f300d06096086480165030402010500a11c301a06092a864886f70d010108300d06096086480165030402010500a203020120",
      "description": "RSASSA-PSS, SHA-256, MGF1-SHA-256, salt 32 (SBR 7.1.3.2.1)"
